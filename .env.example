# MongoDB connection string.
# Local (docker compose up -d):
MONGODB_URI=mongodb://localhost:27017/crossval
# MongoDB Atlas (production) looks like:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/crossval?retryWrites=true&w=majority

# HS256 signing secret for the cv_session JWT.
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-me-with-openssl-rand-hex-32

NODE_ENV=development
